{
  "name": "@offline-translator/nestjs",
  "version": "0.3.0",
  "description": "NestJS module that automatically translates the text fields of your JSON API responses before they reach the frontend.",
  "keywords": [
    "translation",
    "i18n",
    "nestjs",
    "nest",
    "interceptor",
    "json",
    "offline",
    "localization",
    "accept-language"
  ],
  "license": "MIT",
  "author": "Brice Kouevidjin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BriceTheFama/offline-translation-middleware.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/BriceTheFama/offline-translation-middleware/tree/main/packages/nestjs#readme",
  "bugs": "https://github.com/BriceTheFama/offline-translation-middleware/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@offline-translator/middleware": "^0.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "rxjs": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/testing": "^11.0.0",
    "@types/supertest": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
