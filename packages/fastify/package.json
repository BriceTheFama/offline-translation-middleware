{
  "name": "@offline-translator/fastify",
  "version": "0.3.0",
  "description": "Fastify plugin that automatically translates the text fields of your JSON API responses before they reach the frontend.",
  "keywords": [
    "translation",
    "i18n",
    "fastify",
    "fastify-plugin",
    "json",
    "offline",
    "localization",
    "accept-language"
  ],
  "license": "MIT",
  "author": "Brice Kouevidjin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BriceTheFama/offline-translation-middleware.git",
    "directory": "packages/fastify"
  },
  "homepage": "https://github.com/BriceTheFama/offline-translation-middleware/tree/main/packages/fastify#readme",
  "bugs": "https://github.com/BriceTheFama/offline-translation-middleware/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@offline-translator/middleware": "^0.3.0"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
